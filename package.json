{
  "name": "clinical-trial-risk-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "demo:data": "node scripts/create-demo-data.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/server.js",
    "test": "node scripts/test.mjs",
    "eval:model": "node scripts/evaluate-model.mjs",
    "eval:docs": "node scripts/render-evaluation.mjs",
    "eval:validate": "node --test src/evaluation/score.test.js",
    "test:clinical": "node scripts/test-clinical.mjs",
    "demo:clinical": "node scripts/create-clinical-fixture.mjs",
    "start:clinical": "node scripts/start-clinical-demo.mjs",
    "eval:clinical": "node scripts/evaluate-clinical.mjs",
    "start:science": "node scripts/start-science-demo.mjs",
    "test:science": "node scripts/test-science.mjs",
    "eval:science": "node scripts/evaluate-science.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2"
  },
  "packageManager": "pnpm@11.25.0"
}
